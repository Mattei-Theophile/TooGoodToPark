{
  "name": "toogoodtopark",
  "version": "1.0.0",
  "description": "TooGoodToPark Full Stack Application",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "install:all": "npm install && npm install --workspace=frontend && npm install --workspace=backend"
  },
  "dependencies": {
    "rollup": "^4.52.3",
    "v-calendar": "^3.1.2"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8"
  }
}
