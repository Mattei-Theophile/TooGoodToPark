    "sass-embedded": "^1.93.2",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.18",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.1",
    "vue-tel-input": "^9.5.0",
    "vue3-country-region-select": "^1.0.0",
    "vuetify": "^3.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^14.5.3",
    "eslint": "^9.31.0",
    "eslint-plugin-cypress": "^5.1.0",
